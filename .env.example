# ============================================================================
#  VASTRA STUDIO · environment
#  Copy to .env.local. Only section 1 is needed to run; section 2 makes the
#  AI real. Providers switch on automatically when their key is present.
# ============================================================================


# ----------------------------------------------------------------------------
#  1. REQUIRED TO RUN (the app will not start without these)
# ----------------------------------------------------------------------------
# Public URL of the app, no trailing slash. Used for sign-in callbacks and share links.
APP_URL=http://localhost:3000
# Secret for sessions and signed URLs. 32+ random characters.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=


# ----------------------------------------------------------------------------
#  2. REQUIRED FOR REAL RESULTS (paste the key; the provider turns on by itself)
# ----------------------------------------------------------------------------
# [ESSENTIAL] Google Gemini image model ("Nano Banana").
#   Draws the real-looking model around the garment's own pixels (exact-garment route), dresses a
#   model for hanger and flat-lay photos, renders the model library, makes reel scenes and video.
#   Free tier at https://aistudio.google.com  → then about USD 0.04 per image.
GEMINI_API_KEY=

# [STRONGLY RECOMMENDED] Anthropic Claude.
#   Reads each garment photo and judges every result: same suit, embroidery intact, natural hands.
#   Without it a basic offline check runs. Under USD 0.01 per image.
ANTHROPIC_API_KEY=



# ----------------------------------------------------------------------------
#  3. OPTIONAL · better reels
# ----------------------------------------------------------------------------
# fal.ai key for Kling 3.0 clips (about USD 0.56 per 5-second clip). Without it Gemini video is used.
FAL_KEY=


# ----------------------------------------------------------------------------
#  4. LAUNCH ONLY (not needed for testing)
# ----------------------------------------------------------------------------
# Real sign-in emails. Empty = codes print in the terminal (development only).
RESEND_API_KEY=
EMAIL_FROM="Vastra Studio <no-reply@example.com>"

# Selling credits (Razorpay dashboard → API keys and webhook secret).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Managed Postgres (Neon/Supabase, Mumbai). Empty = embedded database in ./.data/pg.
DATABASE_URL=
# Redis for the job queue. Empty = in-process queue (fine on one server).
REDIS_URL=
# Object storage: local | s3. Empty S3_* = local files in ./.data/storage.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Google sign-in button (email codes work without it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that see the /admin console.
PLATFORM_ADMIN_EMAILS=


# ----------------------------------------------------------------------------
#  5. ADVANCED · defaults are fine. Override only to force a provider.
# ----------------------------------------------------------------------------
# auto = follow the keys above. Force with: mock | claude
VISION_PROVIDER=auto
# auto = gemini when GEMINI_API_KEY is set, else mock
PERSON_PROVIDER=auto
STORYBOARD_PROVIDER=auto
# auto = gemini (and google when configured) when keys are set, else mock. Comma-separated priority order.
TRYON_PROVIDERS=auto
# auto = kling,gemini by available keys, else mock
VIDEO_PROVIDERS=auto
# Garment cut-out: auto = bundled on-device model, falling back to a heuristic
SEGMENTER=auto
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
FAL_KLING_MODEL=fal-ai/kling-video/v3/standard/image-to-video
# Google Virtual Try-On fallback (optional second try-on provider)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Credits for a new boutique's trial, and the hourly generation cap per boutique
TRIAL_CREDITS=100
TENANT_JOBS_PER_HOUR=60
