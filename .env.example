# ============================================================================
#  VASTRA STUDIO · environment
#
#  Copy this file to .env.local (development) or set the same variables on your
#  host (Vercel, Fly, Docker) for production. Providers switch on by themselves
#  when their key is present; you never need to flip a provider flag.
#
#  LAUNCH CHECKLIST — every key in sections 1 to 4 is REQUIRED in production.
#  With NODE_ENV=production the app refuses to start if any of them is missing.
# ============================================================================


# ----------------------------------------------------------------------------
#  1. APP  (required everywhere)
# ----------------------------------------------------------------------------
# Public URL of the app, no trailing slash. Used for sign-in links, share links and OAuth callbacks.
#   Development: http://localhost:3000   Production: https://app.yourdomain.in
APP_URL=http://localhost:3000

# Secret for sessions and signed URLs. 32+ random characters. Never reuse between environments.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Comma-separated emails that see the /admin console (tenants, provider switches, content editing).
PLATFORM_ADMIN_EMAILS=you@yourdomain.in


# ----------------------------------------------------------------------------
#  2. AI  (required for real results; the mocks run without them in development)
# ----------------------------------------------------------------------------
# Google Gemini image model. Does every image job: the real-looking model around your garment
# (exact-garment route), try-on for hanger and flat-lay photos, the model library, reel scenes
# and video. Get it: https://aistudio.google.com → "Get API key". Free tier to start; ~USD 0.04/image after.
GEMINI_API_KEY=

# Anthropic Claude. Reads each garment photo and judges every result: same suit, embroidery intact,
# natural hands. Get it: https://console.anthropic.com → API keys. Under USD 0.01 per image.
ANTHROPIC_API_KEY=

# OPTIONAL · fal.ai key for Kling 3.0 reel clips (~USD 0.56 per 5-second clip). Without it, Gemini video is used.
#   Get it: https://fal.ai/dashboard/keys
FAL_KEY=


# ----------------------------------------------------------------------------
#  3. DATA  (required in production: nothing is stored on the server)
# ----------------------------------------------------------------------------
# Managed Postgres, Mumbai region. Neon (https://neon.tech) or Supabase (https://supabase.com).
#   Format: postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require
#   Development: leave empty to use the embedded database in ./.data/pg
DATABASE_URL=
DATABASE_POOL_MAX=10

# Redis for the job queue and rate limits. Upstash (https://upstash.com) or any Redis 7.
#   Format: rediss://default:PASSWORD@HOST:6379
#   Development: leave empty to use the in-process queue
REDIS_URL=

# Object storage for photos, images and reels: Cloudflare R2 (https://dash.cloudflare.com → R2) or AWS S3.
#   Production: STORAGE_DRIVER=s3 and all S3_* values. Development: STORAGE_DRIVER=local (./.data/storage).
STORAGE_DRIVER=local
#   R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com   AWS: leave empty
S3_ENDPOINT=
#   R2: auto   AWS: ap-south-1
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
#   Optional public CDN base for read URLs (a custom domain on the bucket). Leave empty to use signed URLs.
S3_PUBLIC_BASE_URL=


# ----------------------------------------------------------------------------
#  4. EMAIL AND PAYMENTS  (required in production)
# ----------------------------------------------------------------------------
# Resend sends the sign-in codes and team invitations. Get it: https://resend.com → API keys.
# The sending domain in EMAIL_FROM must be verified in Resend.
#   Development: leave empty and codes print in the terminal.
RESEND_API_KEY=
EMAIL_FROM="Vastra Studio <no-reply@yourdomain.in>"

# Razorpay sells credit packs. Dashboard → Settings → API keys (live mode), and Webhooks → add
#   https://app.yourdomain.in/api/webhooks/razorpay for events payment.captured and order.paid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# ----------------------------------------------------------------------------
#  5. OPTIONAL
# ----------------------------------------------------------------------------
# Google sign-in button (email codes work without it).
#   Google Cloud console → APIs & Services → Credentials → OAuth client (Web).
#   Authorised redirect URI: https://app.yourdomain.in/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Virtual Try-On as a second try-on provider (service-account JSON, stringified).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS_JSON=


# ----------------------------------------------------------------------------
#  6. ADVANCED  (defaults are fine)
# ----------------------------------------------------------------------------
# auto = follow the keys above. Force a provider only for tests: mock | claude / gemini / google / kling
VISION_PROVIDER=auto
PERSON_PROVIDER=auto
STORYBOARD_PROVIDER=auto
TRYON_PROVIDERS=auto
VIDEO_PROVIDERS=auto
# Garment cut-out: auto = bundled on-device model, falling back to a heuristic
SEGMENTER=auto
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
FAL_KLING_MODEL=fal-ai/kling-video/v3/standard/image-to-video
# Set to 1 only on a staging box that must run without AI keys; production refuses mocks otherwise.
ALLOW_MOCK_PROVIDERS=
# Credits for a new boutique's trial, and the hourly generation cap per boutique
TRIAL_CREDITS=100
TENANT_JOBS_PER_HOUR=60
# json (default outside development) | pretty
LOG_FORMAT=
