# ---- Core ----
# Public URL of the app (no trailing slash). Used for auth callbacks and share links.
APP_URL=http://localhost:3000
# 32+ random chars. Generate: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string-change-me
# Comma-separated emails that get the platform admin console
PLATFORM_ADMIN_EMAILS=

# ---- Database ----
# Leave empty to use embedded PGlite (./.data/pg). Set to a Postgres URL in staging/production.
DATABASE_URL=

# ---- Queue ----
# Leave empty to use the in-process queue (dev). Set to a Redis URL to use BullMQ workers.
REDIS_URL=

# ---- Object storage ----
# local | s3   (local writes to ./.data/storage and serves via signed app URLs)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public CDN base for read URLs (e.g. https://cdn.example.com). Leave empty to use signed URLs.
S3_PUBLIC_BASE_URL=

# ---- AI providers ----
# Try-on: mock | fashn | google   (comma-separated order = primary, fallback...)
TRYON_PROVIDERS=mock
FASHN_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Google service-account JSON (stringified) or leave empty to use Application Default Credentials
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Vision (garment analysis + quality gate): mock | claude
VISION_PROVIDER=mock
ANTHROPIC_API_KEY=
# Garment cut-out for exact-garment mode: auto | imgly | heuristic | mock
# auto uses the bundled open-source background-removal model (CPU, no key) and falls back to a sharp heuristic.
SEGMENTER=auto
# Exact-garment mode for mannequin photos (the AI draws only the person and backdrop): mock | gemini
PERSON_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# ---- Auth providers ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email (one-time codes). Leave empty in dev: codes are printed to the server console. ----
RESEND_API_KEY=
EMAIL_FROM="Vastra Studio <no-reply@example.com>"

# ---- Payments ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Limits ----
# Credits granted to a new boutique for the trial
TRIAL_CREDITS=100
# Max generation jobs a tenant may start per hour
TENANT_JOBS_PER_HOUR=60
